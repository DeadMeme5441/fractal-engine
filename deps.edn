{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.4"}

  ;; The eval kernel. The model's Clojure runs inside SCI (the babashka
  ;; interpreter) embedded AS A LIBRARY — capability-controlled, no compiler
  ;; dependency. See spec/03-eval-kernel.md and spec/04-capability-sandbox.md.
  ;; PIN this version: the sandbox guarantees are version-dependent and covered
  ;; by a regression test (spec/04). Re-run that test on every bump.
  org.babashka/sci {:mvn/version "0.8.43"}

  ;; The model-facing (inspect x) viewer — bounded/paginated value inspection.
  ;; See spec/03-eval-kernel.md (observation rendering).
  cider/orchard {:mvn/version "0.41.0"}

  ;; The ONLY network seam: all provider calls go through this. The engine never
  ;; speaks HTTP. See spec/05-adapter.md and spec/08-cache.md.
  net.clojars.deadmeme5441/clojure-llm-sdk {:mvn/version "0.2.3"}

  ;; JSON for the CLI's eventual --json/--jsonl; arrives transitively via the SDK,
  ;; pinned so it is deterministic.
  cheshire/cheshire {:mvn/version "5.13.0"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]}

  ;; A REPL for development.
  :dev
  {:extra-paths ["dev"]}}}


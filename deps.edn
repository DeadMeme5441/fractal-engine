{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.4"}

  ;; The eval kernel. The model's Clojure runs inside SCI (the babashka
  ;; interpreter) embedded AS A LIBRARY — capability-controlled, no compiler
  ;; dependency. See spec/03-eval-kernel.md and spec/04-capability-sandbox.md.
  ;; PIN this version: the sandbox guarantees are version-dependent and covered
  ;; by a regression test (spec/04). Re-run that test on every bump.
  org.babashka/sci {:mvn/version "0.8.43"}

  ;; The model-facing (inspect x) viewer — bounded/paginated value inspection.
  ;; See spec/03-eval-kernel.md (observation rendering).
  cider/orchard {:mvn/version "0.41.0"}

  ;; The ONLY network seam: all provider calls go through this. The engine never
  ;; speaks HTTP. See spec/05-adapter.md and spec/08-cache.md.
  net.clojars.deadmeme5441/clojure-llm-sdk {:mvn/version "0.2.3"}

  ;; JSON for the CLI's structured command output; arrives transitively via the
  ;; SDK, pinned here because the CLI is a first-class runtime surface.
  cheshire/cheshire {:mvn/version "5.13.0"}

  ;; The canonical durable event log + sessions table for the SQLite
  ;; SessionStore impl (fractal.engine.store.sqlite). Slots under the same
  ;; SessionStore port as MemoryStore.
  ;; Payloads do NOT live here: they go to a file-based, content-addressed blob
  ;; store (fractal.engine.store.blobstore — no extra dependency). Driven through
  ;; raw JDBC (no wrapper dep). PINNED for determinism.
  org.xerial/sqlite-jdbc {:mvn/version "3.46.1.3"}}

 :aliases
 {;; Default-safe: excludes ^:live so `clojure -M:test` never makes a paid API
  ;; call, even with keys in the environment.
  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "--exclude" ":live"]}

  ;; Opt-in live smoke runner: requires ^:live metadata + a real provider key.
  ;; Exercises SdkAdapter end-to-end; never on the default path (10 §4).
  :live-test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "--include" ":live"]}

  ;; Agent-operable control plane over the public SDK API.
  :cli
  {:main-opts ["-m" "fractal.engine.cli"]}

  ;; Build the library jar and CLI uberjar. Native-image is out because the
  ;; engine evaluates model-written Clojure at runtime.
  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
   :ns-default build}

  ;; Publish the thin library jar to Clojars. Reads CLOJARS_USERNAME and
  ;; CLOJARS_PASSWORD from the environment. CI passes the artifact path on tags.
  :deploy
  {:replace-deps {slipset/deps-deploy {:mvn/version "0.2.2"}}
   :exec-fn deps-deploy.deps-deploy/deploy
   :exec-args {:installer :remote
               :sign-releases? false
               :pom-file "target/classes/META-INF/maven/net.clojars.deadmeme5441/fractal-engine/pom.xml"
               :artifact "target/fractal-engine-0.1.0-SNAPSHOT.jar"}}}}

;; ---------------------------------------------------------------------------
;; org.xerial/sqlite-jdbc backs fractal.engine.store.sqlite: the durable event
;; log and session table. Payloads go to fractal.engine.store.blobstore, which
;; is file-based and content-addressed. Both stores sit behind SessionStore.
;; Native-image is not a release target for this repo; ship jar and uberjar.
;; ---------------------------------------------------------------------------
